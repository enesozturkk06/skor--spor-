# Cloudflare Pages response headers (copied into dist/ by `expo export`).
# Public demo test site: never indexed, no framing, no MIME sniffing.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex

# Expo's hashed bundles and assets: the file name changes with the content,
# so they can be cached forever.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
